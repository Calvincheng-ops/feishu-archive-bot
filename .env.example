# Feishu App Credentials
BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_OPEN_ID=

# Event Subscription (from Feishu Open Platform)
ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bitable Config (optional, for mapping management)
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# App Config
MAX_FILE_SIZE_MB=20
CACHE_REFRESH_INTERVAL=300
LOG_LEVEL=INFO
DB_PATH=./data/archive_bot.db

# Optional local/test mapping. Leave empty in production if using bitable mapping.
ARCHIVE_CHAT_ID=
ARCHIVE_CHAT_NAME=
ARCHIVE_FOLDER_TOKEN=
ARCHIVE_FOLDER_NAME=归档文件夹
